{
  "name": "@opfg/assets-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Spritesheet intelligence: analyses irregular sheets, extracts frames, classifies animations and publishes Phaser atlases.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "opfg-sprites": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "analyse": "node dist/cli.js analyse",
    "extract": "node dist/cli.js extract",
    "contact": "node dist/cli.js contact",
    "clean": "rm -rf dist *.tsbuildinfo",
    "contact-anim": "node dist/cli.js contact-anim"
  },
  "dependencies": {
    "@opfg/combat-core": "*",
    "sharp": "^0.35.4"
  }
}
