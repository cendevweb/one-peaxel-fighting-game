# Copy to .env.local (web) or .env (server). No value here is a secret; the
# file exists so a fresh checkout knows what to set, and so nothing real ever
# has to live in the repository.

# --- apps/server -----------------------------------------------------------
PORT=8080
HOST=0.0.0.0
# Comma-separated origins allowed to open a socket. In production this is the
# Vercel domain; "https://*.vercel.app" also covers preview deployments.
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Frames the client runs ahead of the server. Raise it on a bad connection.
INPUT_DELAY=3
SNAPSHOT_INTERVAL=3
RECONNECT_GRACE_MS=12000

# --- apps/web --------------------------------------------------------------
# Where the browser opens its game socket. On Vercel, set this to the Render
# service URL, for example https://opfg-game-server.onrender.com
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:8080
